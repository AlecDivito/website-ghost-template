{{!< default}}

<div class="page private-cloud">
    {{#post}}
        {{> "hero" }}
    {{/post}}


    <section class="gh-projectfeed">
        <div class="grid project-feed">
            {{#get "posts" filter="primary_tag:project" }}
                {{#foreach posts}}
                    {{> "float-card" page=../pagination.page }}
                {{/foreach}}
            {{/get}}
        </div>
    </section>
</div>