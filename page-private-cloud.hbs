{{!< default}}

<div class="page private-cloud" data-tag="{{@custom.private_cloud_tag}}">
    {{#post}}
        {{> "hero" }}
    {{/post}}

    <section class="gh-projectfeed">
        <div class="grid project-feed">
            {{#get "posts" filter="tag:{{@custom.private_cloud_tag}}" include="tags,authors"}}
                {{#foreach posts}}
                    {{> "float-card" page=../pagination.page }}
                {{/foreach}}
            {{/get}}
        </div>
    </section>
</div>
