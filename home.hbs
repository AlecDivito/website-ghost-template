{{!< default}}

{{> "hero"}}

<div class="page home gh-page">
    <section class="home-section">
        <h2 class="m-b section__title">{{t "Latest Blog Posts"}}</h2>
        <a class="section__link" href="{{@site.url}}/blog/">
            <span>{{t "Read More"}}</span>
            <i class="icon m-r">
                {{> "icons/arrow-right" }}
            </i>
        </a>

        <div class="blog-feed">
            {{#get "posts" limit="9" include="authors,tags" filter="tag:-{{@custom.projects_tag}}+tag:-worked-at" order="published_at DESC"}}
                {{#foreach posts}}
                    {{> "card" page=../pagination.page }}
                {{/foreach}}
            {{/get}}
        </div>
    </section>

    <section class="home-section gh-projectfeed">
        <h2 class="m-b section__title">{{t "Latest work"}}</h2>
        <a class="section__link" href="{{@site.url}}/projects/">
            <span>{{t "View All"}}</span>
            <i class="icon m-r">
                {{> "icons/arrow-right" }}
            </i>
        </a>

        <div class="project-feed">
            {{#get "posts" filter="tag:{{@custom.projects_tag}}" limit="4" include="tags"}}
                {{#foreach posts}}
                    {{> "float-card" page=../pagination.page }}
                {{/foreach}}
            {{/get}}
        </div>
    </section>

    {{#if @custom.show_worked_at}}
        {{!-- Posts tagged worked-at; feature image = logo (PNG or SVG). --}}
        {{#get "posts" filter="tag:worked-at" limit="12" order="published_at DESC"}}
            {{#foreach posts}}
                {{#if @first}}
                    <section class="home-section">
                        <h2 class="m-b section__title">{{t "I Have Worked At"}}</h2>
                        <a class="section__link" href="{{@site.url}}/about/">
                            <span>{{t "and I have done..."}}</span>
                            <i class="icon m-r">
                                {{> "icons/arrow-right" }}
                            </i>
                        </a>
                        <div class="home-companies">
                            <div class="home-companies__track">
                                <div class="home-companies__group">
                {{/if}}
                                    <a class="home-companies__item" href="{{url}}" title="{{title}}">
                                        {{#if feature_image}}
                                            <img
                                                class="logos"
                                                src="{{img_url feature_image size="s"}}"
                                                alt="{{title}}"
                                                loading="lazy"
                                            />
                                        {{else}}
                                            <span class="home-companies__label">{{title}}</span>
                                        {{/if}}
                                    </a>
                {{#if @last}}
                                </div>
                                <div class="home-companies__group" aria-hidden="true">
                {{/if}}
            {{/foreach}}
            {{#foreach posts}}
                                    <a class="home-companies__item" href="{{url}}" title="{{title}}" tabindex="-1">
                                        {{#if feature_image}}
                                            <img
                                                class="logos"
                                                src="{{img_url feature_image size="s"}}"
                                                alt=""
                                                loading="lazy"
                                            />
                                        {{else}}
                                            <span class="home-companies__label">{{title}}</span>
                                        {{/if}}
                                    </a>
                {{#if @last}}
                                </div>
                            </div>
                        </div>
                    </section>
                {{/if}}
            {{/foreach}}
        {{/get}}
    {{/if}}

    <section class="home-section gh-tags">
        <h2 class="m-b section__title">{{t "Popular Categories"}}</h2>
        <a class="section__link" href="{{@site.url}}/tags/">
            <span>{{t "Check them all out"}}</span>
            <i class="icon m-r">
                {{> "icons/arrow-right" }}
            </i>
        </a>

        <div class="tag-grid">
            {{#get "tags" limit="11" include="count.posts" filter="slug:-worked-at+slug:-{{@custom.projects_tag}}" order="count.posts DESC"}}
                {{#foreach tags}}
                    {{> "tag-section-card" }}
                {{/foreach}}
            {{/get}}
        </div>
    </section>
</div>
