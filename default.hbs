<html lang="{{@site.locale}}" data-color-scheme="{{@custom.color_scheme}}">
    <head>

        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <meta name="color-scheme" content="light dark" />

        <link rel="preconnect" href="https://fonts.bunny.net" crossorigin />
        <link href="https://fonts.bunny.net/css?family=fraunces:400,600,700&display=swap" rel="stylesheet" />
        <link href="https://fonts.bunny.net/css?family=ibm-plex-sans:400,500,600&display=swap" rel="stylesheet" />

        <title>{{meta_title}}</title>

        {{ghost_head}}

        <link rel="stylesheet" href="{{asset "built/index.css"}}" />
        <script src="{{asset "built/index.js"}}" defer></script>

    </head>
    <body id="root" class="{{body_class}}">
        <div class="gh-viewport">

            <header id="gh-head" class="gh-head">
                <nav class="gh-head-inner {{#is "post"}}is-post{{/is}}">

                    <div class="gh-head-brand">
                        <a class="gh-head-logo" href="{{@site.url}}">
                            {{#if @site.logo}}
                                <img
                                    src="{{@site.logo}}"
                                    alt="{{@site.title}}"
                                />
                            {{else}}
                                {{@site.title}}
                            {{/if}}
                        </a>
                        <a class="gh-burger" role="button" aria-label="menu">
                            <div class="gh-burger-box">
                                <div class="gh-burger-inner"></div>
                            </div>
                        </a>
                    </div>
                    {{navigation}}
                </nav>
            </header>

            <main class="gh-main">

                {{{body}}}

            </main>

            {{> "footer" }}


        </div>

        {{ghost_foot}}
    </body>
</html>
