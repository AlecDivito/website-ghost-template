<a href="{{url}}" class="tag-card tag-card--{{@number}}">
    {{#if feature_image}}
        <img class="tag__image tag__image--img"
            srcset="{{img_url feature_image size="s"}} 300w,
                    {{img_url feature_image size="m"}} 600w,
                    {{img_url feature_image size="l"}} 900w"
            src="{{img_url feature_image size="l"}}"
            alt="{{#if feature_image_alt}}{{feature_image_alt}}{{else}}{{name}}{{/if}}"
            loading="lazy"
        />
    {{else}}
        <div style="--color-accent: {{accent_color}}" class="tag__image tag__image--color"></div>
    {{/if}}

    <div class="tag-overlay">
        <h2 class="tag-title">{{name}}</h2>
        <p class="tag-count">{{plural count.posts empty="No posts" singular="% post" plural="% posts"}}</p>

    </div>
</a>
