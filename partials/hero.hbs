{{!-- Context-aware page hero --}}
<section class='hero {{#is "home"}}is-home{{/is}} {{^is "post"}}is-not-post{{/is}}'>
    <div class='hero--container common--max-width {{#is "post"}}grid gh-canvas{{/is}}'>
        <div class='hero--z-index hero--content {{#is "post"}}hero--post{{/is}}'>
            {{#is "post"}}
                {{> "tag" }}
            {{/is}}

            <div class='hero__body'>
                <h1 class='hero__title'>
                    {{#is "home"}}
                        <span class='hero__title--content'>
                            {{#if @custom.hero_title}}{{@custom.hero_title}}{{else}}{{@site.title}}{{/if}}
                        </span>
                    {{/is}}

                    {{#is "page"}}
                        {{title}}
                    {{/is}}

                    {{#is "post"}}
                        {{title}}
                    {{/is}}

                    {{#is "tag"}}
                        {{name}}
                    {{/is}}

                    {{#is "author"}}
                        {{name}}
                    {{/is}}
                </h1>

                {{#is "home"}}
                    {{!-- Homepage hero streaming (ghost-chat-agent) — re-enable with initHeroStream() in assets/js/index.js
                    {{#if @custom.chat_agent_url}}
                        <div
                            class='hero__stream'
                            data-hero-stream
                            data-agent-url='{{@custom.chat_agent_url}}'
                            data-chat-url='{{@site.url}}/chat/'
                        >
                            <div
                                class='hero__stream-body'
                                data-hero-stream-body
                                aria-live='polite'
                            >
                                <div class='hero__stream-fallback' data-hero-fallback>
                                    <p class='hero__description'>
                                        {{#if @custom.hero_intro}}{{@custom.hero_intro}}{{else}}and this is a personal development blog about{{/if}}
                                    </p>
                                    <p class='hero__description hero__stream-topics'>
                                        <span class='hero__stream-topic'>networks.</span>
                                        <span class='hero__stream-topic'>Azure.</span>
                                    </p>
                                    <p class='hero__description hero__description--secondary'>
                                        {{#if @custom.hero_supporting_text}}{{@custom.hero_supporting_text}}{{else}}I'm trying to build a private cloud and documenting the process into insanity.{{/if}}
                                        {{#if @site.members_enabled}}
                                            {{#unless @member}}
                                                <a href='#/portal'>{{#if @custom.hero_cta_text}}{{@custom.hero_cta_text}}{{else}}{{t "Join me!"}}{{/if}}</a>
                                            {{/unless}}
                                        {{/if}}
                                    </p>
                                </div>
                            </div>
                            <a
                                class='hero__stream-continue'
                                data-hero-continue
                                href='{{@site.url}}/chat/'
                                hidden
                            >{{t "Continue the conversation"}}</a>
                        </div>
                    {{else}}
                    --}}
                        <p class='hero__description'>
                            {{#if @custom.hero_intro}}{{@custom.hero_intro}}{{else}}{{@site.description}}{{/if}}
                            {{#if @custom.hero_topics}}
                                <span
                                    id='hero-word-rotation'
                                    data-topics='{{@custom.hero_topics}}'
                                ><span></span><span></span></span>
                            {{/if}}
                        </p>
                        {{#if @custom.hero_supporting_text}}
                            <p class='hero__description hero__description--secondary'>
                                {{@custom.hero_supporting_text}}
                                {{#if @site.members_enabled}}
                                    {{#unless @member}}
                                        <a href='#/portal'>{{#if @custom.hero_cta_text}}{{@custom.hero_cta_text}}{{else}}{{t "Join me!"}}{{/if}}</a>
                                    {{/unless}}
                                {{/if}}
                            </p>
                        {{else if @site.description}}
                            <p class='hero__description hero__description--secondary'>{{@site.description}}</p>
                        {{/if}}
                    {{!-- {{/if}} --}}
                {{/is}}

                {{^is "home"}}
                    <p class='hero__description'>
                        {{#is "tag"}}
                            {{description}}
                        {{/is}}
                        {{#is "author"}}
                            {{bio}}
                        {{/is}}
                        {{#is "page"}}
                            {{#has slug="blog"}}{{content}}{{/has}}
                            {{#has slug="projects"}}{{content}}{{/has}}
                            {{#has slug="tags"}}{{content}}{{/has}}
                        {{/is}}
                        {{#is "post"}}
                            {{excerpt}}
                        {{/is}}
                    </p>
                {{/is}}

                {{#is "post"}}
                    {{> "author" }}
                {{/is}}
            </div>
        </div>
    </div>
</section>
<div class='hero-curve-wrap'>
    <svg
        class='hero--curve'
        xmlns='http://www.w3.org/2000/svg'
        preserveAspectRatio='none'
        viewBox='0 0 1200 120'
        aria-hidden='true'
    >
        <path d='M321.39,56.44c58-10.79,114.16-30.13,172-41.86,82.39-16.72,168.19-17.73,250.45-.39C823.78,31,906.67,72,985.66,92.83c70.05,18.48,146.53,26.09,214.34,3V0H0V27.35A600.21,600.21,0,0,0,321.39,56.44Z' />
    </svg>
</div>
