{{!-- Context-aware page hero --}}
<section class='hero {{#is "home"}}is-home{{/is}} {{^is "post"}}is-not-post{{/is}}'>
    <div class='hero--container common--max-width {{#is "post"}}grid gh-canvas{{/is}}'>
        <div class='hero--z-index hero--content {{#is "post"}}hero--post{{/is}}'>
            {{#is "post"}}
                {{> "tag" }}
            {{/is}}

            {{#is "home"}}
                <div
                    class='hero__home'
                    data-hero-home
                    {{#if @custom.chat_agent_url}}data-chat-url='{{@site.url}}/chat/'{{/if}}
                >
                    <div class='hero__field' data-hero-field aria-hidden='true'>
                        <canvas class='hero__field-canvas' data-hero-field-canvas width='320' height='240'></canvas>
                    </div>

                    <div class='hero__copy'>
                        <h1 class='hero__title'>
                            <span class='hero__title--content'>
                                {{#if @custom.hero_title}}{{@custom.hero_title}}{{else}}{{@site.title}}{{/if}}
                            </span>
                        </h1>

                        <div
                            class='hero__stream'
                            data-hero-stream
                            aria-live='polite'
                        >
                            <p class='hero__lead'>
                                {{#if @custom.hero_intro}}{{@custom.hero_intro}}{{else}}and this is a personal development blog about{{/if}}
                                {{#if @custom.hero_topics}}
                                    <span
                                        id='hero-word-rotation'
                                        data-topics='{{@custom.hero_topics}}'
                                    ><span></span><span></span></span>
                                {{else}}
                                    <span class='hero__topics'>
                                        <span class='hero__topic'>networks.</span>
                                    </span>
                                {{/if}}
                            </p>

                            <div class='hero__stream-body' data-hero-stream-body></div>

                            <div class='hero__stream-fallback' data-hero-fallback hidden>
                                <p class='hero__hook'>
                                    {{#if @custom.hero_supporting_text}}{{@custom.hero_supporting_text}}{{else}}I'm trying to build a private cloud and documenting the process into insanity.{{/if}}
                                    {{#if @site.members_enabled}}
                                        {{#unless @member}}
                                            <a href='#/portal'>{{#if @custom.hero_cta_text}}{{@custom.hero_cta_text}}{{else}}{{t "Join me!"}}{{/if}}</a>
                                        {{/unless}}
                                    {{/if}}
                                </p>
                            </div>

                            {{!-- Post catalog for random streamed blurbs (no live LLM) --}}
                            <div class='hero__catalog' data-hero-catalog hidden>
                                {{#get "posts" limit="16" include="tags" filter="tag:-{{@custom.projects_tag}}+tag:-worked-at" order="published_at DESC"}}
                                    {{#foreach posts}}
                                        <article
                                            data-slug='{{slug}}'
                                            data-title='{{title}}'
                                            data-excerpt='{{excerpt}}'
                                            data-url='{{url}}'
                                            data-tags='{{#foreach tags}}{{#unless @first}},{{/unless}}{{name}}{{/foreach}}'
                                        ></article>
                                    {{/foreach}}
                                {{/get}}
                            </div>

                            {{#if @custom.chat_agent_url}}
                                <a
                                    class='gh-button hero__stream-continue'
                                    data-hero-continue
                                    href='{{@site.url}}/chat/'
                                    hidden
                                >{{t "Chat with me"}}</a>
                            {{/if}}
                        </div>
                    </div>
                </div>
            {{else}}
                <div class='hero__body'>
                    <h1 class='hero__title'>
                        {{#is "page"}}
                            {{title}}
                        {{/is}}

                        {{#is "post"}}
                            {{title}}
                        {{/is}}

                        {{#is "tag"}}
                            {{name}}
                        {{/is}}

                        {{#is "author"}}
                            {{name}}
                        {{/is}}
                    </h1>

                    <p class='hero__description'>
                        {{#is "tag"}}
                            {{description}}
                        {{/is}}
                        {{#is "author"}}
                            {{bio}}
                        {{/is}}
                        {{#is "page"}}
                            {{#has slug="blog"}}{{content}}{{/has}}
                            {{#has slug="projects"}}{{content}}{{/has}}
                            {{#has slug="tags"}}{{content}}{{/has}}
                        {{/is}}
                        {{#is "post"}}
                            {{excerpt}}
                        {{/is}}
                    </p>

                    {{#is "post"}}
                        {{> "author" }}
                    {{/is}}
                </div>
            {{/is}}
        </div>
    </div>
</section>
<div class='hero-curve-wrap'>
    <svg
        class='hero--curve'
        xmlns='http://www.w3.org/2000/svg'
        preserveAspectRatio='none'
        viewBox='0 0 1200 120'
        aria-hidden='true'
    >
        <path d='M321.39,56.44c58-10.79,114.16-30.13,172-41.86,82.39-16.72,168.19-17.73,250.45-.39C823.78,31,906.67,72,985.66,92.83c70.05,18.48,146.53,26.09,214.34,3V0H0V27.35A600.21,600.21,0,0,0,321.39,56.44Z' />
    </svg>
</div>
