<!-- Hero -->
<section class='hero'>
    <div class='hero--container common--max-width {{#is "post"}}grid gh-canvas{{/is}}'>
        <div class='hero--z-index hero--content {{#is "post"}}hero--post{{/is}}'>
            {{#is 'page,tag'}}
                {{#if feature_image}}
                    <div class="hero__image--container">
                        <img class="hero__image" src="{{feature_image}}" alt="{{#if feature_image_alt}}{{feature_image_alt}}{{else}}{{title}}{{/if}}" />
                    </div>
                {{/if}}
            {{/is}}

            <div class='hero__body'>
                <h1 class='hero__title'>
                    {{#is 'home'}}
                        <span class='hero__title--emoji'>👋</span>
                        <span class='hero__title--content'>Hi there, let's talk about</span>
                        <div id='hero-word-rotation'>
                            <div>Kubernetes👌</div>
                            <div></div>
                        </div>
                    {{/is}}

                    {{#is 'page'}}
                        {{title}}
                    {{/is}}

                    {{#is 'post'}}
                        {{title}}
                    {{/is}}

                    {{#is 'tag'}}
                        {{name}}
                    {{/is}}
                </h1>

                <p class='hero__description'>
                    {{#is 'home'}}
                        {{description}}
                    {{/is}}
                    {{#is 'tag'}}
                        {{description}}
                    {{/is}}
                    {{#is 'page'}}
                        {{#has slug="blog"}} {{content}} {{/has}}
                        {{#has slug="projects"}} {{content}} {{/has}}
                        {{#has slug="private-cloud"}} {{content}} {{/has}}
                    {{/is}}
                    {{#is 'post'}}
                        <span class='gh-post-meta'>
                            <time datetime='{{date format='YYYY-MM-DD'}}'>{{date format='D MMM YYYY'}}</time>
                            <span class='bull'>&bull;</span>
                            {{reading_time}}
                        </span>
                    {{/is}}
                </p>
            {{!--
            {{#is "tag"}}
            <p class="hero__description">
            A collection of {{plural ../pagination.total empty='posts' singular='% post' plural='% posts'}}
            </p>
            {{/is}}
            --}}
                <div class='hero--flex'>
                    <ul class='hero__list'>
                        {{#foreach tags visibility='all'}}
                        <li class='hero__list__item'>
                            <div class='gh-tag gh-tag--invert'>
                                {{name}}
                            </div>
                        </li>
                        {{/foreach}}
                    </ul>
                </div>
            </div>
        </div>
    </div>
</section>
<div style="position: relative">
    <svg
    style="position: absolute"
    class='hero--curve'
    xmlns='http://www.w3.org/2000/svg'
    preserveAspectRatio='none'
    viewBox='0 0 1200 120'
    >
    <path
        d='M321.39,56.44c58-10.79,114.16-30.13,172-41.86,82.39-16.72,168.19-17.73,250.45-.39C823.78,31,906.67,72,985.66,92.83c70.05,18.48,146.53,26.09,214.34,3V0H0V27.35A600.21,600.21,0,0,0,321.39,56.44Z'
        fill='#475de6'
    />
    </svg>
</div>