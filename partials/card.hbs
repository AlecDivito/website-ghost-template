{{!--
Re-usable card for linking to posts
--}}

<article class="widget {{post_class}} widget--{{@number}}">
    {{#if feature_image}}
        {{!-- This is a responsive image, it loads different sizes depending on device
        https://medium.freecodecamp.org/a-guide-to-responsive-images-with-ready-to-use-templates-c400bd65c433 --}}
        <div class="widget--img-container">
            <a href="{{url}}">
                <img class="widget__image"
                    srcset="{{img_url feature_image size="s"}} 300w,
                            {{img_url feature_image size="m"}} 600w,
                            {{img_url feature_image size="l"}} 900w"
                    {{!sizes="auto"--}}
                    src="{{img_url feature_image size="l"}}"
                    alt="{{#if feature_image_alt}}{{feature_image_alt}}{{else}}{{title}}{{/if}}"
                    loading="lazy"
                />
            </a>

            {{#unless access}}
            {{^has visibility="public"}}
                <div class="widget__access">
                    <i class="icon icon-lock icon--sm">
                        {{> "icons/lock"}}
                    </i>
                    {{#has visibility="members"}}
                        Members only
                    {{else}}
                        Paid-members only
                    {{/has}}
                </div>
            {{/has}}
            {{/unless}}

            {{#if featured}}
                <div class="widget__featured">
                    <i class="icon icon-star filled">
                        {{> "icons/star" }}
                    </i>
                </div>
            {{/if}}
            </div>
    {{/if}}

    <div class="widget__body">
        {{#unless feature_image}}
        <div class="widget__notifications m-b">
            {{#unless access}}
            {{^has visibility="public"}}
                <div class="widget__access">
                    <i class="icon icon-lock icon--sm">
                        {{> "icons/lock"}}
                    </i>
                    {{#has visibility="members"}}
                        Members only
                    {{else}}
                        Paid-members only
                    {{/has}}
                </div>
            {{/has}}
            {{/unless}}

            {{#if featured}}
                <div class="widget__access--relative widget__featured">
                    <i class="icon icon-star filled">
                        {{> "icons/star" }}
                    </i>
                </div>
            {{/if}}
        </div>
        {{/unless}}

        {{> "tag" }}

        <div class="widget__content">
            <a href="{{url}}">
                <h2 class="widget__title">
                    {{title}}
                </h2>
            </a>

            {{#is "home, page"}}
                {{#is "home"}}
                    {{#match @number '<' 4}}
                        <p class="widget__description">{{excerpt}}</p>
                    {{/match}}
                {{else}}
                    {{#match @number '<' 2}}
                        <p class="widget__description">{{excerpt}}</p>
                    {{else}}
                        {{#unless  feature_image}}
                            <p class="widget__description">{{excerpt}}</p>
                        {{/unless}}
                    {{/match}}
                {{/is}}
            {{else}}
                {{#unless  feature_image}}
                    <p class="widget__description">{{excerpt}}</p>
                {{/unless}}
            {{/is}}
        </div>

        <div class="widget__author">
            {{> "author" }}
        </div>
    </div>
</article>

