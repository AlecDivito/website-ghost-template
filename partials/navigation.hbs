{{#if isSecondary}}
    {{#foreach navigation}}
    <li class="nav-home footer__list__item {{#if current}}nav-current{{/if}}">
        <a href="{{url absolute="true"}}" class="internal-link {{#if current}}nav-current{{/if}}">{{label}}</a>
    </li>
    {{/foreach}}
{{else}}
    <div class="gh-head-menu" id="nav-menu">
        <ul class="nav">
            {{#foreach navigation}}
            <li class="nav-home {{#if current}}nav-current{{/if}}">
                <a href="{{url absolute="true"}}" class="internal-link {{#if current}}nav-current{{/if}}">{{label}}</a>
            </li>
            {{/foreach}}
            {{#if @custom.chat_agent_url}}
                <li class="nav-chat {{link_class for="/chat/" activeClass="nav-current"}}">
                    <a href="{{@site.url}}/chat/" class="internal-link {{link_class for="/chat/" activeClass="nav-current"}}">{{t "Chat"}}</a>
                </li>
            {{/if}}
        </ul>

        <div class="gh-head-actions">
            <div class="gh-head-actions-list">
                {{search}}
                {{#if @site.members_enabled}}
                    {{#if @member}}
                        <a
                            class="gh-button"
                            href="#/portal/account"
                        >{{t "Account"}}</a>
                    {{else}}
                        <a
                            class="gh-button"
                            href="{{@site.signup_url}}"
                        >{{t "Subscribe"}}</a>
                    {{/if}}
                {{/if}}
            </div>
        </div>
    </div>
{{/if}}
