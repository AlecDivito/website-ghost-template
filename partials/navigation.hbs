{{#if isSecondary}}
    {{#foreach navigation}}
    <li class="nav-home footer__list__item {{#if current}}nav-current{{/if}}">
        <a href="{{url absolute="true"}}" class="internal-link {{#if current}}nav-current{{/if}}">{{label}}</a>
    </li>
    {{/foreach}}
{{else}}
    <div class="gh-head-menu" id="nav-menu">
        <ul class="nav">
            {{#foreach navigation}}
            <li class="nav-home {{#if current}}nav-current{{/if}}">
                <a href="{{url absolute="true"}}" class="internal-link {{#if current}}nav-current{{/if}}">{{label}}</a>
            </li>
            {{/foreach}}
            {{#get "pages" filter="slug:chat" limit="1" as |chat_pages|}}
                {{#foreach chat_pages}}
                    <li class="nav-chat{{#match @root.slug "=" "chat"}} nav-current{{/match}}">
                        <a href="{{url absolute="true"}}" class="internal-link{{#match @root.slug "=" "chat"}} nav-current{{/match}}">{{t "Chat"}}</a>
                    </li>
                {{/foreach}}
            {{/get}}
        </ul>

        <div class="gh-head-actions">
            <div class="gh-head-actions-list">
                {{search}}
                {{#if @site.members_enabled}}
                    {{#if @member}}
                        <a
                            class="gh-button"
                            href="#/portal/account"
                        >{{t "Account"}}</a>
                    {{else}}
                        <a
                            class="gh-button"
                            href="{{@site.signup_url}}"
                        >{{t "Subscribe"}}</a>
                    {{/if}}
                {{/if}}
            </div>
        </div>
    </div>
{{/if}}
