<svg class="footer--svg" xmlns="http://www.w3.org/2000/svg" preserveAspectRatio="none" viewBox="0 0 1200 120">
    <path d="M321.39,56.44c58-10.79,114.16-30.13,172-41.86,82.39-16.72,168.19-17.73,250.45-.39C823.78,31,906.67,72,985.66,92.83c70.05,18.48,146.53,26.09,214.34,3V0H0V27.35A600.21,600.21,0,0,0,321.39,56.44Z" fill="#475de6" />
</svg>

<footer class="footer {{#is "home"}}home{{/is}}">
    <div class="footer--container">
        <div class="footer--row">
            <h3 class="m-b">{{@site.title}}</h3>
            <div class="footer__form">
                <p class="m-b">Learn more about programming and self hosting software locally, sign up!</p>
            </div>
        </div>

        <div class="footer__links__items">
            <h4 class="m-b">Navigation</h4>
            <ul class="nav footer__list footer--row">
                {{ navigation type='secondary' }}
            </ul>
        </div>

        <div class="footer__links__items">
            <h4 class="m-b">Socials</h4>
            <ul class="nav footer__list footer--row">
                <li class="nav-home footer__list__item footer__list__item--social">
                    <a href="https://github.com/alecdivito" target="_blank" class="link">
                        <i class="icon icon--sm">
                            {{> "icons/github" }}
                        </i>
                        GitHub
                    </a>
                </li>
                <li class="nav-home footer__list__item footer__list__item--social">
                    <a href="https://www.linkedin.com/in/alec-divito/" target="_blank" class="link">
                        <i class="icon icon--sm">
                            {{> "icons/linkedin" }}
                        </i>
                        Linkedin
                    </a>
                </li>
            </ul>
        </div>
    </div>
</footer>
