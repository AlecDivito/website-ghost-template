{
  "name": "alecdivito-website-ghost-theme",
  "description": "Personal Ghost theme for Alec Di Vito — development and self-hosting notes",
  "demo": "https://alecdivito.com",
  "version": "2.0.0",
  "engines": {
    "ghost": ">=5.0.0"
  },
  "license": "MIT",
  "screenshots": {
    "desktop": "assets/screenshot-desktop.jpg"
  },
  "scripts": {
    "dev": "rollup -c --environment BUILD:development -w",
    "build": "rollup -c --environment BUILD:production",
    "zip": "npm run build && bestzip $npm_package_name.zip assets/* partials/* members/* locales/* *.hbs package.json",
    "test": "npx gscan .",
    "pretest": "npm run build"
  },
  "author": {
    "name": "Alec Di Vito",
    "email": "divito.alec@gmail.com",
    "url": "https://alecdivito.com"
  },
  "gpm": {
    "type": "theme",
    "categories": [
      "Minimal",
      "Personal"
    ]
  },
  "keywords": [
    "ghost",
    "theme",
    "ghost-theme",
    "personal",
    "blog"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/alecdivito/website-ghost-template.git"
  },
  "bugs": "https://github.com/alecdivito/website-ghost-template/issues",
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@babel/preset-env": "^7.29.7",
    "@rollup/plugin-babel": "^7.1.0",
    "@rollup/plugin-commonjs": "^29.0.3",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-terser": "^1.0.0",
    "bestzip": "^3.0.1",
    "postcss": "^8.5.19",
    "postcss-import": "^16.1.1",
    "postcss-preset-env": "^11.3.2",
    "rollup": "^4.62.2",
    "rollup-plugin-livereload": "^2.0.5",
    "rollup-plugin-postcss": "^4.0.2"
  },
  "browserslist": [
    "defaults"
  ],
  "config": {
    "card_assets": true,
    "posts_per_page": 10,
    "image_sizes": {
      "xxs": {
        "width": 30
      },
      "xs": {
        "width": 100
      },
      "s": {
        "width": 300
      },
      "m": {
        "width": 600
      },
      "l": {
        "width": 1200
      },
      "xl": {
        "width": 2000
      }
    },
    "custom": {
      "hero_title": {
        "type": "text",
        "default": "I'm Alec Di Vito",
        "group": "homepage"
      },
      "hero_intro": {
        "type": "text",
        "default": "and this is a personal development blog about",
        "group": "homepage"
      },
      "hero_topics": {
        "type": "text",
        "default": "Kubernetes, networks, Azure, DevOps, Git, VLANs, Rust, JavaScript, Python",
        "description": "Comma-separated words that rotate in the homepage hero",
        "group": "homepage"
      },
      "hero_supporting_text": {
        "type": "text",
        "default": "I'm trying to build a private cloud and documenting the process into insanity.",
        "group": "homepage"
      },
      "hero_cta_text": {
        "type": "text",
        "default": "Join me!",
        "group": "homepage"
      },
      "show_worked_at": {
        "type": "boolean",
        "default": true,
        "description": "Show “I Have Worked At” from Ghost posts tagged worked-at (feature image = logo, PNG or SVG)",
        "group": "homepage"
      },
      "projects_tag": {
        "type": "text",
        "default": "project",
        "description": "Tag slug used for project posts on home and /projects",
        "group": "homepage"
      },
      "show_publication_name": {
        "type": "boolean",
        "default": false,
        "description": "Show the publication name in the header instead of the publication logo"
      },
      "footer_cta": {
        "type": "text",
        "default": "Learn more about programming and self-hosting — sign up!"
      },
      "github_url": {
        "type": "text",
        "default": "https://github.com/alecdivito"
      },
      "linkedin_url": {
        "type": "text",
        "default": "https://www.linkedin.com/in/alec-divito/"
      },
      "chat_agent_url": {
        "type": "text",
        "default": "",
        "description": "Origin of ghost-chat-agent (e.g. https://chat.alecdivito.com). Enables the Chat nav link and chat page. Empty disables both."
      }
    }
  },
  "type": "module"
}
