{{!< default}}

<div class="page tags">
    {{#tag}}
    {{> "hero" }}
    {{/tag}}

    <div class="gh-postfeed">
    {{#foreach posts}}

        {{> "card"}} {{!-- partials/card.hbs --}}

    {{/foreach}}


    </div>

    <section>
        <h2 class="m-b home-section section__title">Check out other popular categories</h2>

        <div class="grid tag-grid">
            {{#get "tags" limit="4" include="count.posts" order="count.posts DESC"}}
                {{#foreach tags}}
                    {{> "tag-section-card" }}
                {{/foreach}}
            {{/get}}
        </div>
    </section>
</div>
