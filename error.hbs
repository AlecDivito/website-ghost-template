<!DOCTYPE html>
<html lang="{{@site.locale}}">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <link rel="preconnect" href="https://fonts.bunny.net">
    <link href="https://fonts.bunny.net/css?family=jetbrains-mono:400" rel="stylesheet" />
    <link rel="stylesheet" href="{{asset "built/index.css"}}" />
    <script src="{{asset "built/index.js"}}" defer></script>

    <title>{{meta_title}}</title>

    {{ghost_head}}
</head>
<body id="root" class="{{body_class}} error-template">
<div class="gh-viewport">

    <header id="gh-head" class="gh-head">
        <nav class="gh-head-inner">
            <div class="gh-head-brand">
                <a class="gh-head-logo" href="{{@site.url}}">
                    {{#if @custom.show_publication_name}}
                        <span class="gh-head-logo__name">{{@site.title}}</span>
                    {{else if @site.logo}}
                        <img src="{{@site.logo}}" alt="{{@site.title}}" />
                    {{else}}
                        {{@site.title}}
                    {{/if}}
                </a>
                <a class="gh-burger" role="button" aria-label="{{t "menu"}}">
                    <div class="gh-burger-box">
                        <div class="gh-burger-inner"></div>
                    </div>
                </a>
            </div>
            {{navigation}}
        </nav>
    </header>

    <main class="gh-main">
        <section class="hero is-not-post error-hero">
            <div class="hero--container common--max-width">
                <div class="hero--z-index hero--content">
                    <div class="hero__body">
                        <p class="error-hero__code" aria-hidden="true">{{statusCode}}</p>
                        <h1 class="hero__title">
                            {{#match statusCode "=" 404}}
                                {{t "Page not found"}}
                            {{else}}
                                {{t "Something went wrong"}}
                            {{/match}}
                        </h1>
                        <p class="hero__description">
                            {{#if message}}
                                {{message}}
                            {{else}}
                                {{#match statusCode "=" 404}}
                                    {{t "That page doesn’t exist — or it moved."}}
                                {{else}}
                                    {{t "Please try again in a moment."}}
                                {{/match}}
                            {{/if}}
                        </p>
                        <p class="hero__description hero__description--secondary">
                            <a class="gh-button" href="{{@site.url}}">{{t "Back to home"}}</a>
                        </p>
                    </div>
                </div>
            </div>
        </section>
        <div class="hero-curve-wrap">
            <svg
                class="hero--curve"
                xmlns="http://www.w3.org/2000/svg"
                preserveAspectRatio="none"
                viewBox="0 0 1200 120"
                aria-hidden="true"
            >
                <path d="M321.39,56.44c58-10.79,114.16-30.13,172-41.86,82.39-16.72,168.19-17.73,250.45-.39C823.78,31,906.67,72,985.66,92.83c70.05,18.48,146.53,26.09,214.34,3V0H0V27.35A600.21,600.21,0,0,0,321.39,56.44Z" />
            </svg>
        </div>

        {{#if errorDetails}}
            <section class="gh-container error-stack">
                <h2 class="section__title m-b">{{t "Theme errors:"}}</h2>
                <ul class="error-stack__list">
                    {{#foreach errorDetails}}
                        <li class="error-stack__item">
                            <h3 class="error-stack__rule">{{{rule}}}</h3>
                            {{#foreach failures}}
                                <p class="error-stack__detail"><strong>{{t "Ref:"}}</strong> {{ref}}</p>
                                <p class="error-stack__detail"><strong>{{t "Message:"}}</strong> {{message}}</p>
                            {{/foreach}}
                        </li>
                    {{/foreach}}
                </ul>
            </section>
        {{/if}}
    </main>

    {{> "footer"}}

</div>

{{ghost_foot}}

</body>
</html>
