{{!< default}}

{{!-- Opt-in chat page. Create a Ghost Page with slug "chat" and set Theme Setting chat_agent_url. --}}
{{!-- Marked is loaded here (not in the Rollup bundle) so the chat page can render streamed markdown. --}}
{{!-- Sync (no defer): must run before deferred theme bundle so window.marked exists for streaming render. --}}
<script src="https://cdn.jsdelivr.net/npm/marked@15.0.12/marked.min.js"></script>

{{#page}}
    <div
        class="page chat"
        data-chat-root
        data-agent-url="{{@custom.chat_agent_url}}"
    >
        {{> "hero"}}

        <section class="chat-shell gh-container">
            {{#unless @custom.chat_agent_url}}
                <p class="chat-status chat-status--warn" role="status">
                    Chat isn’t configured yet. Set the theme setting <code>chat_agent_url</code> to your agent origin.
                </p>
            {{else}}
                <p class="chat-status" data-chat-status role="status">Connecting…</p>

                <div class="chat-transcript" data-chat-messages aria-live="polite" hidden></div>

                <form class="chat-composer" data-chat-form>
                    <label class="sr-only" for="chat-input">Message</label>
                    <div class="chat-composer__field">
                        <textarea
                            id="chat-input"
                            class="chat-composer__input"
                            data-chat-input
                            rows="1"
                            placeholder="Ask about a post, project, or experience…"
                            required
                            autofocus
                        ></textarea>
                        <button
                            type="submit"
                            class="chat-composer__send"
                            data-chat-send
                            aria-label="Send message"
                        >
                            <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" focusable="false">
                                <path
                                    fill="currentColor"
                                    d="M12 4.5a1 1 0 0 1 1 1v10.59l3.3-3.3a1 1 0 1 1 1.4 1.42l-5 5a1 1 0 0 1-1.4 0l-5-5a1 1 0 1 1 1.4-1.42l3.3 3.3V5.5a1 1 0 0 1 1-1z"
                                    transform="rotate(180 12 12)"
                                />
                            </svg>
                        </button>
                    </div>
                </form>
            {{/unless}}
        </section>
    </div>
{{/page}}
